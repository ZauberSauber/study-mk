<main>
    <h2>Настройки</h2>
    
    <form>
        {{#block}}
            {{>Avatar atlText="Ваш аватар"}}
            {{>Button text="Выбрать новый аватар"}}
        {{/block}}

        {{#block}}
            {{>Input name="first_name" value="Иван" label="Имя" }}
        {{/block}}

        {{#block}}
            {{>Input name="last_name" value="Иванов" label="Фамилия" }}
        {{/block}}

        {{#block}}
            {{>Input name="patronymic" value="Иванович" label="Отчество" }}
        {{/block}}

        {{#block}}
            {{>Input name="display_name" value="Ivanov_II" label="Отображаемое имя" }}
        {{/block}}

        {{#block}}
            {{>Input name="email" value="ivanov_ii@yandex.ru" label="Электронная почта" }}
        {{/block}}

        {{#block}}
            {{>Input name="phone" value="..." label="Телефон" }}
        {{/block}}

        {{#block}}
            {{>Input name="login" value="ivanovii" label="Логин" }}
        {{/block}}

        {{#block}}
            {{>Input name="oldPassword" value="*****" label="Действующий пароль" }}
        {{/block}}

        {{#block}}
            {{>Input value="newPassword" label="Новый пароль" }}
        {{/block}}

        {{#block}}
            {{>Button text="Сохранить"}}
        {{/block}}
    </form>

    <a href="/">home page</a>
</main>
