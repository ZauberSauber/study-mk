.chat-page
    display grid
    grid-template-columns: 1fr 3fr

    .chat-menu
        padding 10px 15px
        height 65px

    .chat-list
        padding 0 10px 0 15px

    .chat-content
        background #bababa
        display grid

    .chat-active
        display flex
        padding 10px
        height 65px
        background #f0f0f0

    .active-icon
        margin-right 15px
        width 45px
        height 45px
        border-radius $border-radius

    .active-name
        display block
        font-size: 14px

    .messages
        padding 20px
        padding-bottom 0
        display flex
        flex-direction column
        align-items flex-end

    .chat-input
        padding 5px
        display grid
        grid-template-columns auto 95px
        background #8d8d8d
        height 70px

        #user-input
            padding 10px
            margin-right 10px
            border-radius $border-radius
            border none
            &:focus
                outline none
                border none

        .send-button
            border-radius $border-radius