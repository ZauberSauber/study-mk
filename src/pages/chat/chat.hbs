<main class="chat-page">
    <aside>
        <div class="chat-menu">
            {{>Button text="Меню"}}
        </div>

        <div class="chat-list">
            {{#each chats}}
                {{>ChatBadge}}
            {{/each}}
        </div>

        <a href="/">home page</a>
    </aside>
    
    <div class="chat-content">
       <div class="chat-active">
            <img src="{{activeSrs}}" class="active-icon">
            <title class="active-name">Название активного чата</title>
       </div>
       <div class="messages">
            {{#each messages as |messageData|}}
                {{>Message data=messageData}}
            {{/each}}
       </div>
       <div class="chat-input">
            <textarea id="user-input" placeholder="Сообщение..."></textarea>
            <button class="send-button">></button>
       </div>
    </div>
</main>