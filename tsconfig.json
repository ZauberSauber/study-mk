{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "es6",
    "lib": ["ES6", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "rootDir": "./src",
    "allowJs": true,
    "sourceMap": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
