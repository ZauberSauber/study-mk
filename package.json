{
  "engines": {
    "node": "22.16.0"
  },
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite build && vite preview",
    "stylus": "stylus --watch src/styles/ --out dist/css/",
    "style-fix": "stylelint --fix ./src/**/*.styl",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint-staged": "lint-staged",
    "test": "mocha",
    "prepare": "husky && husky install",
    "pre-commit": "npm run lint-staged && npm run test"
  },
  "lint-staged": {
    "*.{js,ts}": "npm run lint",
    "*.{css,styl}": "npm run stylus"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run pre-commit"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/chai": "^5.2.2",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.3",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "chai": "^6.0.1",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.1.6",
    "mocha": "^11.7.2",
    "path": "^0.12.7",
    "sinon": "^21.0.0",
    "stylelint": "^16.21.0",
    "stylelint-stylus": "^1.0.0",
    "stylus": "^0.64.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.1.7",
    "vite-plugin-checker": "^0.10.2",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-handlebars": "^2.0.0"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "uuid": "^11.1.0"
  }
}
